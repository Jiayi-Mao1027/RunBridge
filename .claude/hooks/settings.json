{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ../.claude/hooks/hook_session_start.py"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ../.claude/hooks/hook_session_start.py"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ../.claude/hooks/hook_subagent_stop.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ../.claude/hooks/hook_user_prompt_submit.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ../.claude/hooks/hook_pre_tool_use.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ../.claude/hooks/hook_post_tool_use.py"
          }
        ]
      }
    ],
    "BridgeWindowOpened": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ../.claude/hooks/hook_bridge_event.py"
          }
        ]
      }
    ],
    "BridgePacketAccepted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ../.claude/hooks/hook_bridge_event.py"
          }
        ]
      }
    ],
    "BridgePacketRejected": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ../.claude/hooks/hook_bridge_event.py"
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ../.claude/hooks/hook_task_created.py"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ../.claude/hooks/hook_task_completed.py"
          }
        ]
      }
    ],
    "TeamIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ../.claude/hooks/hook_team_idle.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ../.claude/hooks/hook_stop.py"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ../.claude/hooks/hook_session_end.py"
          }
        ]
      }
    ]
  }
}
