{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runbridge-state-snapshot.schema.json",
  "title": "RunBridgeState",
  "type": "object",
  "required": [
    "repo_key",
    "run_id",
    "phase",
    "lifecycle_state",
    "active_bridge_window_id",
    "retry_context",
    "trajectory_head",
    "open_process_refs",
    "pending_approvals",
    "hard_stops",
    "diagnostics"
  ],
  "properties": {
    "repo_key": {"type": "string"},
    "run_id": {"type": "string"},
    "phase": {"type": "string"},
    "lifecycle_state": {"type": "string"},
    "graph_node": {"type": "string"},
    "active_bridge_window_id": {"type": ["string", "null"]},
    "active_team_id": {"type": ["string", "null"]},
    "active_task_id": {"type": ["string", "null"]},
    "frozen_semantics_hash": {"type": ["string", "null"]},
    "packet_hash": {"type": ["string", "null"]},
    "completion_contract_hash": {"type": ["string", "null"]},
    "retry_context": {"type": "object"},
    "trajectory_head": {"type": "object"},
    "open_process_refs": {"type": "array", "items": {"type": "object"}},
    "pending_approvals": {"type": "array", "items": {"type": "object"}},
    "hard_stops": {"type": "array", "items": {"type": "object"}},
    "diagnostics": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": true
}
