{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "control/schemas/transition_record.schema.json",
  "title": "Transition Record",
  "description": "Authoritative transition decision record for run-level and task-level state changes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transition_id",
    "run_id",
    "timestamp",
    "entity_type",
    "action",
    "decision",
    "from_state",
    "to_state",
    "guard_results",
    "trigger"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.3.0"
    },
    "transition_id": {
      "type": "string",
      "pattern": "^tr_[A-Za-z0-9._-]+$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_[A-Za-z0-9._-]+$"
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^task_[A-Za-z0-9._-]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "entity_type": {
      "type": "string",
      "enum": [
        "run",
        "task"
      ]
    },
    "action": {
      "type": "string",
      "enum": [
        "create_task",
        "start_task",
        "move_task_to_waiting",
        "block_task",
        "retry_task",
        "complete_task",
        "fail_task",
        "abort_task",
        "noop_task",
        "advance_phase",
        "reroute_phase",
        "pause_run",
        "resume_run",
        "request_approval",
        "resolve_approval",
        "mark_hard_stop",
        "clear_hard_stop",
        "complete_run",
        "abort_run"
      ]
    },
    "decision": {
      "type": "string",
      "enum": [
        "allowed",
        "denied",
        "blocked",
        "noop"
      ]
    },
    "from_state": {
      "$ref": "#/$defs/stateSnapshot"
    },
    "to_state": {
      "$ref": "#/$defs/stateSnapshot"
    },
    "reason_code": {
      "type": "string",
      "enum": [
        "phase_entry_condition_met",
        "phase_exit_condition_met",
        "phase_exit_condition_not_met",
        "task_dependency_resolved",
        "task_dependency_blocked",
        "task_acceptance_contract_met",
        "task_acceptance_contract_failed",
        "retry_allowed",
        "retry_denied",
        "reroute_without_semantic_change",
        "scope_change_requires_approval",
        "external_side_effect_requires_approval",
        "approval_granted",
        "approval_rejected",
        "unsafe_runtime_state",
        "policy_denied",
        "illegal_phase_transition",
        "illegal_task_transition",
        "hard_stop_active",
        "manual_override",
        "noop",
        "other"
      ]
    },
    "reason": {
      "type": "string"
    },
    "approval_category": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "intra_group_default",
        "cross_group_advance_default",
        "cross_group_reroute_default",
        "scope_change_requires_approval",
        "external_side_effect_requires_approval",
        "hard_stop",
        null
      ]
    },
    "trigger": {
      "$ref": "#/$defs/trigger"
    },
    "guard_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/guardResult"
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_ledger_updated": {
          "type": "boolean"
        },
        "task_ledger_updated": {
          "type": "boolean"
        },
        "task_created": {
          "type": "boolean"
        },
        "approval_created": {
          "type": "boolean"
        },
        "hard_stop_changed": {
          "type": "boolean"
        },
        "checkpoint_written": {
          "type": "boolean"
        },
        "artifact_refs_added": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^art_[A-Za-z0-9._-]+$"
      },
      "uniqueItems": true
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "stateSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_status": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "initialized",
            "in_progress",
            "awaiting_approval",
            "paused",
            "blocked_for_user_clarification",
            "paused_for_user_answer",
            "user_answer_received",
            "resume_same_l3_task",
            "continuation_of_previous_l3",
            "blocked",
            "failed",
            "completed",
            "aborted",
            null
          ]
        },
        "phase": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "leader_freeze",
            "l2_advisory",
            "l3_bridge",
            "l4_implement",
            "l4_execute",
            "l4_anomaly",
            null
          ]
        },
        "task_status": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "created",
            "ready",
            "in_progress",
            "waiting_on_dependency",
            "waiting_on_approval",
            "blocked",
            "retryable_failure",
            "completed",
            "failed",
            "aborted",
            "noop",
            null
          ]
        },
        "task_group": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "leader_freeze",
            "l2_advisory",
            "l3_bridge",
            "l4_implement",
            "l4_execute",
            "l4_anomaly",
            null
          ]
        },
        "task_kind": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "freeze_contract",
            "advisory_pass",
            "bridge_refresh",
            "bridge_curation",
            "bridge_preflight_gate",
            "implement_change",
            "implement_run_gate",
            "execute_run",
            "execute_postrun_check",
            "anomaly_analysis",
            "custom",
            null
          ]
        }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "system",
            "reconcile",
            "manual",
            "policy",
            "hook"
          ]
        },
        "hook_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "guardResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guard_type",
        "guard_name",
        "result"
      ],
      "properties": {
        "guard_type": {
          "type": "string",
          "enum": [
            "phase_graph",
            "task_dependency",
            "task_contract",
            "approval_matrix",
            "hard_stop",
            "policy",
            "artifact_evidence",
            "runtime_safety"
          ]
        },
        "guard_name": {
          "type": "string"
        },
        "result": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "warn",
            "skip"
          ]
        },
        "details": {
          "type": "string"
        }
      }
    }
  }
}
