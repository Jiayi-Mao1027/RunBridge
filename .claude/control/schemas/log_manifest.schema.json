{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "log-manifest.schema.json",
  "title": "FormalLogManifest",
  "type": "object",
  "required": [
    "run_id",
    "bridge_window_id",
    "task_id",
    "command",
    "cwd",
    "environment_evidence",
    "process_refs",
    "terminal_status"
  ],
  "properties": {
    "run_id": {"type": "string"},
    "bridge_window_id": {"type": "string"},
    "task_id": {"type": "string"},
    "stage_name": {"type": "string"},
    "command": {
      "anyOf": [
        {"type": "string"},
        {"type": "object"},
        {"type": "array"}
      ]
    },
    "cwd": {"type": "string"},
    "environment_evidence": {},
    "conda_env_evidence": {},
    "batchbasis": {},
    "gpu_id_or_device_ids": {},
    "smoke_memory_observed": {},
    "warmup_memory_observed": {},
    "formal_memory_observed": {},
    "model_or_model_family": {},
    "dataset_name_split_source": {},
    "method_or_objective": {},
    "process_refs": {
      "anyOf": [
        {"type": "array"},
        {"type": "object"},
        {"type": "string"}
      ]
    },
    "log_files": {"type": "array"},
    "produced_artifacts": {
      "anyOf": [
        {"type": "array"},
        {"type": "object"}
      ]
    },
    "formal_completion_evidence": {
      "description": "Approved formal target quantity versus observed terminal quantity, with source refs such as exit code, log tail, losses, checkpoints, output counts, or not_applicable reason for non-countable work."
    },
    "terminal_status": {"type": "string"}
  },
  "additionalProperties": true
}
