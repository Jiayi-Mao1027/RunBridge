{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "teammate-report.schema.json",
  "title": "TeammateReport",
  "type": "object",
  "required": ["summary", "instruction_coverage"],
  "properties": {
    "summary": {"type": "string"},
    "progress_state": {"type": "string"},
    "completed_items": {"type": "array"},
    "open_items": {"type": "array"},
    "blocked_items": {"type": "array"},
    "evidence_refs": {"type": "array"},
    "file_refs": {"type": "array"},
    "instruction_coverage": {"type": "object"},
    "semantic_identity_resolution": {"type": "object"}
  },
  "additionalProperties": true
}
