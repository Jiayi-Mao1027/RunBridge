{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "completion-report.schema.json",
  "title": "CompletionReport",
  "type": "object",
  "required": ["completion_checks", "reports", "artifact_refs"],
  "properties": {
    "completion_contract": {"type": "object"},
    "completion_checks": {"type": "object"},
    "completion_evidence": {"type": ["object", "null"]},
    "reports": {"type": "array", "items": {"type": "object"}},
    "artifact_refs": {"type": "array", "items": {"type": "string"}},
    "missing_contract_items": {"type": "array"}
  },
  "additionalProperties": true
}
