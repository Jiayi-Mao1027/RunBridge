{
  "schema_version": "0.1.0",
  "workflow_name": "bridge_window_workflow",
  "description": "Native RunBridge state graph. This makes the existing phase graph and lifecycle transition policy explicit as nodes and edges without introducing a LangGraph dependency.",
  "nodes": [
    {"id": "read_runtime_truth", "description": "Read ledgers, snapshot, observer indexes, and repo registry truth", "type": "control"},
    {"id": "freeze_semantics", "description": "Freeze execution-relevant user semantics and scope", "type": "control"},
    {"id": "validate_route", "description": "Validate target phase and route against policy", "type": "control"},
    {"id": "build_bridge_packet", "description": "Build one BridgePacket for one bridge invocation", "type": "control"},
    {"id": "precheck_bridge_call", "description": "Record and precheck main-leader bridge call", "type": "lifecycle"},
    {"id": "bridge_call_denied", "description": "Bridge call denied by runtime guard", "type": "terminal", "terminal": true},
    {"id": "open_bridge_window", "description": "Open and accept one bridge window", "type": "lifecycle"},
    {"id": "packet_rejected", "description": "Bridge packet rejected", "type": "terminal"},
    {"id": "create_team", "description": "Create the bridge-owned team", "type": "lifecycle"},
    {"id": "create_task", "description": "Create and bind the single bridge task", "type": "lifecycle"},
    {"id": "dispatch_teammate_messages", "description": "Dispatch bounded teammate assignments", "type": "lifecycle"},
    {"id": "wait_team", "description": "Wait or poll for team progress and owned process state", "type": "lifecycle"},
    {"id": "collect_reports", "description": "Collect teammate reports", "type": "lifecycle"},
    {"id": "collect_artifacts", "description": "Collect artifacts and process evidence", "type": "lifecycle"},
    {"id": "validate_completion", "description": "Validate completion contract and structured evidence", "type": "lifecycle"},
    {"id": "retry_or_escalate", "description": "Schedule bounded retry, repair, or escalation", "type": "recovery"},
    {"id": "close_team", "description": "Delete or close the bridge team", "type": "lifecycle"},
    {"id": "return_bridge_result", "description": "Return one BridgeResult to main leader", "type": "terminal", "terminal": true},
    {"id": "mark_orphaned", "description": "Mark bridge window orphaned or heartbeat-lost", "type": "recovery"},
    {"id": "enter_anomaly", "description": "Route to anomaly analysis or surface system failure", "type": "recovery"},
    {"id": "blocked_for_user_clarification", "description": "Pause for user clarification within the same L3 task", "type": "pause"},
    {"id": "paused_for_user_answer", "description": "Wait for or process the user answer", "type": "pause"},
    {"id": "terminal_failure", "description": "Terminal failed bridge/window state", "type": "terminal", "terminal": true}
  ],
  "edges": [
    {
      "id": "runtime_truth_to_freeze",
      "from": "read_runtime_truth",
      "to": "freeze_semantics",
      "event_kinds": ["session_started", "user_prompt_submitted", "semantic_frozen"]
    },
    {
      "id": "freeze_to_route",
      "from": "freeze_semantics",
      "to": "validate_route",
      "event_kinds": ["phase_advanced", "route_rerouted"]
    },
    {
      "id": "phase_routes_policy",
      "from": "validate_route",
      "to": "build_bridge_packet",
      "phase_routes": [
        ["leader_freeze", "l2_advisory"],
        ["leader_freeze", "l3_bridge"],
        ["l2_advisory", "l3_bridge"],
        ["l3_bridge", "l3_bridge"],
        ["l3_bridge", "leader_freeze"],
        ["l3_bridge", "l2_advisory"],
        ["l3_bridge", "l4_implement"],
        ["l3_bridge", "l4_execute"],
        ["l3_bridge", "l4_anomaly"],
        ["l4_implement", "l4_execute"],
        ["l4_implement", "l4_anomaly"],
        ["l4_execute", "l4_anomaly"],
        ["l4_execute", "l4_implement"],
        ["l4_anomaly", "l3_bridge"],
        ["l4_anomaly", "l4_implement"],
        ["l4_anomaly", "l4_execute"]
      ]
    },
    {"id": "packet_to_precheck", "from": "build_bridge_packet", "to": "precheck_bridge_call", "event_kinds": ["bridge_call_intended"]},
    {"id": "precheck_denied", "from": "precheck_bridge_call", "to": "bridge_call_denied", "event_kinds": ["pretooluse_denied_by_main_leader"]},
    {"id": "precheck_to_open", "from": "precheck_bridge_call", "to": "open_bridge_window", "event_kinds": ["pretooluse_allowed_by_main_leader", "call_bridge_sdk_started", "bridge_window_opened", "bridge_packet_accepted"]},
    {"id": "packet_rejected", "from": "open_bridge_window", "to": "packet_rejected", "event_kinds": ["bridge_packet_rejected"]},
    {"id": "packet_rejection_return", "from": "packet_rejected", "to": "return_bridge_result", "event_kinds": ["bridge_result_returned"]},
    {"id": "open_to_team", "from": "open_bridge_window", "to": "create_team", "event_kinds": ["team_create_started", "team_create_succeeded"]},
    {"id": "team_to_task", "from": "create_team", "to": "create_task", "event_kinds": ["task_create_started", "task_create_succeeded", "taskcreated_hook_accepted"]},
    {"id": "task_to_dispatch", "from": "create_task", "to": "dispatch_teammate_messages", "event_kinds": ["message_dispatch_started", "message_dispatch_succeeded"]},
    {"id": "dispatch_to_wait", "from": "dispatch_teammate_messages", "to": "wait_team", "event_kinds": ["team_idle_waiting"]},
    {"id": "dispatch_collect_artifacts", "from": "dispatch_teammate_messages", "to": "collect_artifacts", "event_kinds": ["artifacts_ready"]},
    {"id": "wait_collect_artifacts", "from": "wait_team", "to": "collect_artifacts", "event_kinds": ["artifacts_ready"]},
    {"id": "wait_collect_reports", "from": "wait_team", "to": "collect_reports", "event_kinds": ["partial_evidence_collected"]},
    {"id": "collect_reports_validate", "from": "collect_reports", "to": "validate_completion", "event_kinds": ["completion_contract_satisfied"]},
    {"id": "collect_artifacts_validate", "from": "collect_artifacts", "to": "validate_completion", "event_kinds": ["completion_contract_satisfied"]},
    {"id": "collect_reports_retry", "from": "collect_reports", "to": "retry_or_escalate", "event_kinds": ["completion_contract_rejected"]},
    {"id": "collect_artifacts_retry", "from": "collect_artifacts", "to": "retry_or_escalate", "event_kinds": ["completion_contract_rejected"]},
    {"id": "completion_to_close", "from": "validate_completion", "to": "close_team", "event_kinds": ["team_delete_started"]},
    {"id": "close_team_completed", "from": "close_team", "to": "close_team", "event_kinds": ["team_delete_succeeded"]},
    {"id": "completion_retry", "from": "validate_completion", "to": "retry_or_escalate", "event_kinds": ["completion_contract_rejected", "retry_attempt_scheduled"]},
    {"id": "returned_result_repair_retry", "from": "return_bridge_result", "to": "retry_or_escalate", "event_kinds": ["retry_attempt_scheduled"]},
    {"id": "retry_to_anomaly", "from": "retry_or_escalate", "to": "enter_anomaly", "event_kinds": ["enter_anomaly"]},
    {"id": "retry_to_wait", "from": "retry_or_escalate", "to": "wait_team", "event_kinds": ["continue_waiting", "retry_artifact_collection", "message_dispatch_retry_started"]},
    {"id": "wait_retry_or_escalate", "from": "wait_team", "to": "retry_or_escalate", "event_kinds": ["wait_timeout_or_process_lost"]},
    {"id": "clarification_pause", "from": "wait_team", "to": "blocked_for_user_clarification", "event_kinds": ["user_clarification_required", "blocked_for_user_clarification"]},
    {"id": "clarification_to_paused", "from": "blocked_for_user_clarification", "to": "paused_for_user_answer", "event_kinds": ["bridge_result_returned_with_user_clarification_request", "paused_for_user_answer"]},
    {"id": "clarification_resume", "from": "paused_for_user_answer", "to": "validate_route", "event_kinds": ["user_answer_received", "resume_same_l3_task", "continuation_of_previous_l3"]},
    {"id": "close_to_return", "from": "close_team", "to": "return_bridge_result", "event_kinds": ["bridge_result_returned", "bridge_result_returned_with_failure", "bridge_result_returned_with_partial", "bridge_result_returned_with_cleanup_required"]},
    {"id": "orphan_to_anomaly", "from": "wait_team", "to": "mark_orphaned", "event_kinds": ["orphan_timeout_without_heartbeat"]},
    {"id": "open_orphan_to_anomaly", "from": "open_bridge_window", "to": "mark_orphaned", "event_kinds": ["orphan_timeout_without_bridge_return"]},
    {"id": "mark_orphaned_to_anomaly", "from": "mark_orphaned", "to": "enter_anomaly", "event_kinds": ["orphan_timeout_without_bridge_return", "orphan_timeout_without_heartbeat"]},
    {"id": "precheck_failure_retry", "from": "precheck_bridge_call", "to": "retry_or_escalate", "event_kinds": ["call_bridge_sdk_error"]},
    {"id": "create_team_failure_retry", "from": "create_team", "to": "retry_or_escalate", "event_kinds": ["team_create_failed"]},
    {"id": "create_task_failure_retry", "from": "create_task", "to": "retry_or_escalate", "event_kinds": ["task_create_failed", "taskcreated_hook_denied"]},
    {"id": "dispatch_failure_retry", "from": "dispatch_teammate_messages", "to": "retry_or_escalate", "event_kinds": ["message_dispatch_failed", "team_executor_failed"]},
    {"id": "wait_failure_retry", "from": "wait_team", "to": "retry_or_escalate", "event_kinds": ["team_executor_failed"]},
    {"id": "close_failure_retry", "from": "close_team", "to": "retry_or_escalate", "event_kinds": ["team_delete_failed"]},
    {
      "id": "failures_to_terminal",
      "from": "retry_or_escalate",
      "to": "terminal_failure",
      "event_kinds": [
        "call_bridge_sdk_error",
        "team_create_failed",
        "task_create_failed",
        "taskcreated_hook_denied",
        "message_dispatch_failed",
        "team_executor_failed",
        "bridge_leader_fails_task",
        "task_failed_by_bridge_leader",
        "team_delete_failed",
        "bridge_call_interrupted"
      ]
    }
  ]
}
