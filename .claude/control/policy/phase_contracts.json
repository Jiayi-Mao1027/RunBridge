{
  "schema_version": "0.1.0",
  "workflow_name": "bridge_window_workflow",
  "description": "System-owned phase, role, report, and execution contracts used to build BridgePacket fields. Agent prompts may explain role behavior, but these contracts own packet structure.",
  "tool_sets": {
    "read_only": ["Read", "Grep", "Glob", "LS"],
    "research": ["Read", "Grep", "Glob", "LS", "WebSearch", "WebFetch"],
    "read_check": ["Read", "Grep", "Glob", "LS", "Bash"],
    "anomaly": ["Read", "Grep", "Glob", "LS", "Bash", "WebSearch", "WebFetch"],
    "l3_curator": ["Read", "Grep", "Glob", "LS", "Bash", "Edit", "Write"],
    "write": ["Read", "Grep", "Glob", "LS", "Bash", "Edit", "Write"]
  },
  "default_bridge_actions": ["team_create", "task_create", "send_messages", "task_complete", "team_delete"],
  "default_forbidden_actions": [
    "destructive filesystem operations outside writable scopes",
    "external network calls through Bash or project code unless explicitly approved; WebSearch/WebFetch are allowed only when present in allowed_tools and used for task-relevant research",
    "dependency installation unless explicitly approved",
    "implementation content edits during L3 artifact curation unless the file is human-facing documentation already in L3 doc scope",
    "physical deletion of user/project artifacts unless the item is clearly regenerable trash, an empty duplicate, or explicitly approved"
  ],
  "classification_taxonomy": {
    "common": ["execution_layer_fix", "nonblocking_risk", "user_decision", "orchestrator_default", "hard_stop"],
    "gate": ["ready_to_proceed"],
    "postrun": ["execution_defect", "method_underperformance", "nonblocking_risk_or_deviation", "suspicious_result_requiring_anomaly_analysis", "acceptable_completion"],
    "coverage": ["completed", "deferred", "blocked", "escalated"],
    "semantic_disposition": ["resolved", "inherited", "unknown", "blocked", "escalated", "not_applicable"],
    "intent_disposition": ["confirmed", "refined", "superseded", "blocked", "escalated"]
  },
  "semantic_resolution_contract": {
    "required_identity_fields": [
      "model_or_method_identity",
      "checkpoint_identity",
      "dataset_identity",
      "prompt_or_template_identity",
      "code_config_basis",
      "metric_or_objective_identity",
      "inherited_defaults"
    ],
    "resolution_policy": [
      "actively resolve identities from the frozen instruction and current repository state",
      "if the user did not request a change, inherit the current active dataset/prompt/config basis and say where it came from",
      "for model or method comparisons, name the concrete checkpoints or checkpoint-selection rule for each side",
      "do not let L4 implement or execute infer unresolved identities silently",
      "unknown identity fields must be marked unknown, blocked, or escalated with a concrete reason"
    ]
  },
  "manifest_contracts": {
    "formal_log_manifest_required_fields": [
      "run_id",
      "bridge_window_id",
      "task_id",
      "stage_name",
      "teammate_or_agent_name",
      "timestamps",
      "command",
      "cwd",
      "environment_evidence",
      "conda_env_evidence",
      "checkpoint_path_or_id",
      "config_paths",
      "prompt_or_template_path_or_id",
      "output_checkpoint_log_paths",
      "batchbasis",
      "requested_or_upstream_batch_setting",
      "smoke_derived_basis",
      "final_per_device_batch_size",
      "microbatch_size",
      "gradient_accumulation",
      "sequence_length",
      "precision",
      "effective_batch_size",
      "adjustment_reason",
      "gpu_id_or_device_ids",
      "selected_gpu_total_free_memory",
      "competing_process_summary",
      "smoke_memory_observed",
      "warmup_memory_observed",
      "formal_memory_observed",
      "model_or_model_family",
      "checkpoint_semantic_label",
      "dataset_name_split_source",
      "dataset_count",
      "method_or_objective",
      "early_stop_behavior",
      "metric_or_objective_basis",
      "inherited_defaults",
      "process_refs",
      "log_files",
      "produced_artifacts",
      "expected_outputs_or_checkpoints",
      "terminal_status",
      "failure_reason",
      "reuse_or_dependency_notes",
      "residual_uncertainty"
    ]
  },
  "retry_policies": {
    "bridge_sdk_call": {
      "initial_interval_ms": 2000,
      "backoff_coefficient": 2.0,
      "maximum_interval_ms": 30000,
      "maximum_attempts": 3,
      "non_retryable_error_types": [
        "PacketBindingMismatch",
        "TargetRepoBoundaryViolation",
        "PendingApproval",
        "FrozenSemanticsMismatch",
        "ClaudeTmuxTerminalError",
        "ClaudeTmuxTerminalApiError",
        "ClaudeTmuxSoftTimeoutNoProgress",
        "ClaudeTmuxTimeout",
        "TransientClaudeTmuxTransportApiError",
        "ProviderTransportApiError",
        "ProviderTransportConnectionRefused",
        "ProviderTransportRateLimited",
        "ProviderTransportReset",
        "ProviderGateTimeout"
      ]
    },
    "teammate_report_missing": {
      "initial_interval_ms": 5000,
      "backoff_coefficient": 1.5,
      "maximum_interval_ms": 60000,
      "maximum_attempts": 4
    },
    "completion_rejected": {
      "initial_interval_ms": 0,
      "backoff_coefficient": 1.0,
      "maximum_interval_ms": 0,
      "maximum_attempts": 2,
      "requires_same_packet_boundary": true
    },
    "l4_execute_process_poll": {
      "heartbeat_timeout_ms": 300000,
      "maximum_attempts": 0,
      "retry_until_terminal_process_state": true
    }
  },
  "base_report_contract": {
    "required_sections": ["summary", "evidence", "instruction_coverage", "semantic_identity_resolution"],
    "required_evidence": ["runtime event ids", "instruction coverage disposition", "semantic identity resolution"],
    "artifact_reporting_format": "list",
    "include_failure_reason": true,
    "include_next_action_recommendation": true
  },
  "base_completion_contract": {
    "required_outputs": ["report"],
    "required_artifacts": [],
    "validation_requirements": [],
    "success_criteria": [
      "bridge leader collected a report from the team",
      "every instruction coverage checklist item is completed, deferred with reason, blocked, or escalated"
    ],
    "allowed_partial_result": true,
    "timeout_policy": {
      "heartbeat_interval_seconds": 60,
      "soft_timeout_seconds": 900,
      "hard_timeout_seconds": 3600,
      "timeout_action": "ask_main_leader"
    }
  },
  "team_planner": {
    "enabled": true,
    "force_full_team_markers": ["three-seat", "full team", "chiefmate", "multi-view", "high risk"],
    "risk_terms": {
      "ambiguity": ["ambiguous", "clarify", "unclear", "strategy", "plan"],
      "write_risk": ["delete", "move", "refactor", "rewrite", "migration", "update", "edit", "write", "CLAUDE.md", "README"],
      "external_fact_dependency": ["latest", "paper", "research", "web", "benchmark"],
      "failure_recovery_required": ["failed", "partial", "orphan", "recovery", "anomaly"],
      "semantic_identity_uncertain": ["checkpoint", "dataset", "model", "metric", "prompt", "config"]
    },
    "phase_rules": {
      "l2_advisory": {
        "reduced_teammates": ["chiefmate-a"],
        "full_team_risks": ["ambiguity", "external_fact_dependency", "semantic_identity_uncertain"]
      },
      "l3_bridge": {
        "reduced_teammates": ["preflight-initial"],
        "full_team_risks": ["write_risk", "semantic_identity_uncertain", "external_fact_dependency"]
      },
      "l4_anomaly": {
        "reduced_teammates": ["anomaly-analyst-a"],
        "full_team_risks": ["failure_recovery_required", "external_fact_dependency"]
      }
    }
  },
  "phases": {
    "l2_advisory": {
      "bridge_tools": ["Agent", "Read", "Grep", "Glob", "LS", "WebSearch", "WebFetch"],
      "ownership_boundary": {"readable_scopes": ["."], "writable_scopes": []},
      "teammates": [
        {"teammate_name": "chiefmate-a", "role": "advisory", "allowed_tools": ["Read", "Grep", "Glob", "LS", "WebSearch", "WebFetch"], "responsibilities": ["produce upstream interpretation, assumptions, plan critique, peer challenges, and confidence-loop advisory judgment"]},
        {"teammate_name": "chiefmate-b", "role": "advisory", "allowed_tools": ["Read", "Grep", "Glob", "LS", "WebSearch", "WebFetch"], "responsibilities": ["produce independent upstream advisory judgment, critique chiefmate-a/chiefmate-c, and challenge weak convergence"]},
        {"teammate_name": "chiefmate-c", "role": "advisory", "allowed_tools": ["Read", "Grep", "Glob", "LS", "WebSearch", "WebFetch"], "responsibilities": ["produce additional GPT-main peer critique, actively rebut weak peer convergence, challenge chiefmate-a/chiefmate-b, and run confidence-loop validation"]}
      ],
      "report_contract_additions": {
        "required_sections": ["major_technical_plan_pseudocode"],
        "required_evidence": ["pseudocode flow for each new major technical plan or explicit not_applicable reason"]
      }
    },
    "l3_bridge": {
      "bridge_tools": ["Agent", "Read", "Grep", "Glob", "LS", "Bash", "Edit", "Write"],
      "ownership_boundary": {"readable_scopes": ["."], "writable_scopes": ["."]},
      "teammates": [
        {"teammate_name": "curator", "role": "artifact_curation", "allowed_tools": ["Read", "Grep", "Glob", "LS", "Bash", "Edit", "Write"], "responsibilities": ["clarify active logs, datasets, checkpoints, outputs, archive boundaries, and traceability; use Bash only for bounded filesystem curation"]},
        {"teammate_name": "preflight-initial", "role": "preflight_audit", "allowed_tools": ["Read", "Grep", "Glob", "LS"], "responsibilities": ["inspect implementation-facing repo/config state and surface required changes before implementation without running commands"]},
        {"teammate_name": "refresher", "role": "documentation_refresh", "allowed_tools": ["Read", "Grep", "Glob", "LS", "Edit", "Write"], "responsibilities": ["refresh CLAUDE.md and bounded human-facing repository documentation when needed"]}
      ],
      "report_contract_additions": {
        "required_sections": ["current_user_intent_context"],
        "required_evidence": ["current user intent confirmed refined superseded blocked or escalated with reason"]
      }
    },
    "l4_implement": {
      "bridge_tools": ["Agent", "Read", "Grep", "Glob", "LS", "Bash", "Edit", "Write"],
      "ownership_boundary": {"readable_scopes": ["."], "writable_scopes": ["."]},
      "teammates": [
        {"teammate_name": "implementor", "role": "implement", "allowed_tools": ["Read", "Grep", "Glob", "LS", "Bash", "Edit", "Write"], "responsibilities": ["make approved code/config changes and collect bounded validation evidence"]},
        {"teammate_name": "rungater", "role": "implementation_gate", "allowed_tools": ["Read", "Grep", "Glob", "LS", "Bash"], "responsibilities": ["judge post-implementation readiness and recommend proceed, repair, reroute, or stop"]}
      ]
    },
    "l4_execute": {
      "bridge_tools": ["Agent", "Read", "Grep", "Glob", "LS", "Bash", "Write"],
      "ownership_boundary": {"readable_scopes": ["."], "writable_scopes": ["."]},
      "timeout_policy": {
        "heartbeat_interval_seconds": 120,
        "soft_timeout_seconds": 21600,
        "hard_timeout_seconds": 86400,
        "executor_hard_timeout_disabled": true,
        "timeout_action": "ask_main_leader",
        "wait_until_process_complete": true,
        "partial_return_allowed_only_after_process_terminal": true
      },
      "teammates": [
        {"teammate_name": "executor", "role": "formal_execute", "allowed_tools": ["Read", "Grep", "Glob", "LS", "Bash", "Write"], "responsibilities": ["run the approved workflow and record exact execution evidence"]},
        {"teammate_name": "postrun", "role": "postrun_audit", "allowed_tools": ["Read", "Grep", "Glob", "LS", "Bash"], "responsibilities": ["audit execution artifacts, terminal status, outcome classification, and recommended next route"]}
      ],
      "completion_contract_additions": {
        "required_artifacts": ["log_manifest"],
        "validation_requirements": [
          "generated formal log folders include internal manifests",
          "log manifests include required identity command cwd batchbasis gpu memory and semantic fields"
        ],
        "success_criteria": [
          "formal execution log folders are not identified by filename alone; each generated log folder has an internal manifest with identity, command, cwd, batchbasis, GPU/memory, and natural-language semantic fields"
        ]
      },
      "report_contract_additions": {
        "required_sections": ["artifact_manifests"],
        "required_evidence": [
          "log manifest path",
          "formal execution parameter manifest",
          "manifest required fields checklist",
          "batchbasis",
          "gpu_id",
          "smoke memory observed when smoke ran",
          "warmup memory observed when warmup ran",
          "natural-language model dataset method semantics"
        ]
      }
    },
    "l4_anomaly": {
      "bridge_tools": ["Agent", "Read", "Grep", "Glob", "LS", "Bash", "WebSearch", "WebFetch"],
      "ownership_boundary": {"readable_scopes": ["."], "writable_scopes": []},
      "teammates": [
        {"teammate_name": "anomaly-analyst-a", "role": "anomaly_analysis", "allowed_tools": ["Read", "Grep", "Glob", "LS", "Bash", "WebSearch", "WebFetch"], "responsibilities": ["perform complete independent anomaly diagnosis before peer review"]},
        {"teammate_name": "anomaly-analyst-b", "role": "anomaly_analysis", "allowed_tools": ["Read", "Grep", "Glob", "LS", "Bash", "WebSearch", "WebFetch"], "responsibilities": ["perform complete independent anomaly diagnosis before peer review"]},
        {"teammate_name": "anomaly-analyst-c", "role": "anomaly_analysis", "allowed_tools": ["Read", "Grep", "Glob", "LS", "Bash", "WebSearch", "WebFetch"], "responsibilities": ["perform complete independent anomaly diagnosis before peer review, with extra emphasis on rebutting weak peer causal convergence"]}
      ]
    }
  }
}
