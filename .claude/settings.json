{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ANTHROPIC_BASE_URL": "http://mjydsb.top",
    "ANTHROPIC_AUTH_TOKEN": "sk-litellm-mux1m959mwfaov44jtudmdirxxm5ke9d",
    "API_TIMEOUT_MS": "600000",
    "HTTP_PROXY": "http://127.0.0.1:17890",
    "HTTPS_PROXY": "http://127.0.0.1:17890",
    "PYTHONNOUSERSITE": "1",
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTHONIOENCODING": "utf-8"
  },
  "agent": "leader-orchestrator",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ../.claude/hooks/hook_session_start.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ../.claude/hooks/hook_user_prompt_submit.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python ../.claude/hooks/hook_pre_tool_use.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python ../.claude/hooks/hook_post_tool_use.py"
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ../.claude/hooks/hook_task_created.py"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ../.claude/hooks/hook_task_completed.py"
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ../.claude/hooks/hook_team_idle.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ../.claude/hooks/hook_stop.py"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ../.claude/hooks/hook_session_end.py"
          }
        ]
      }
    ]
  }
}
