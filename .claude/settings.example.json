{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ANTHROPIC_BASE_URL": "__REPLACE_BASE_URL__",
    "ANTHROPIC_AUTH_TOKEN": "__REPLACE_AUTH_TOKEN__",
    "API_TIMEOUT_MS": "600000",
    "HTTP_PROXY": "",
    "HTTPS_PROXY": "",
    "PYTHONNOUSERSITE": "1",
    "PYTHONDONTWRITEBYTECODE": "1"
  },
  "agent": "leader-orchestrator",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ../.claude/hooks/hook_user_prompt_submit.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python ../.claude/hooks/hook_pre_tool_use.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__bridge__call_bridge_sdk|call_bridge_sdk|team_create|task_create|send_messages|send_message|team_delete",
        "hooks": [
          {
            "type": "command",
            "command": "python ../.claude/hooks/hook_post_tool_use.py"
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ../.claude/hooks/hook_task_created.py"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ../.claude/hooks/hook_task_completed.py"
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ../.claude/hooks/hook_team_idle.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ../.claude/hooks/hook_stop.py"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ../.claude/hooks/hook_session_end.py"
          }
        ]
      }
    ]
  }
}
