  "bridge_window_opened" [shape=box, label="Bridge leader opened the bridge window"];
  "bridge_packet_accepted" [shape=box, label="Bridge leader accepted the packet boundary"];
  "bridge_packet_rejected" [shape=box, label="Bridge leader rejected the packet boundary"];
  "team_create_started" [shape=box, label="Bridge team creation started"];
