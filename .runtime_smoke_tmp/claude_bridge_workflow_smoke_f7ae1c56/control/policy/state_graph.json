{
  "schema_version": "0.2.0",
  "workflow_name": "bridge_window_workflow",
  "description": "Native RunBridge state graph. Nodes mirror phase routing and bridge lifecycle states without introducing a LangGraph dependency.",
  "nodes": [
    {
      "id": "read_runtime_truth",
      "description": "Read ledgers, snapshot, observer indexes, and repo registry truth",
      "type": "control"
    },
    {
      "id": "freeze_semantics",
      "description": "Freeze execution-relevant user semantics and scope",
      "type": "control"
    },
    {
      "id": "validate_route",
      "description": "Validate target phase and route against policy",
      "type": "control"
    },
    {
      "id": "build_bridge_packet",
      "description": "Build one BridgePacket for one bridge invocation",
      "type": "control"
    },
    {
      "id": "bridge_call_intended",
      "description": "Main leader intends to call the bridge SDK",
      "type": "lifecycle"
    },
    {
      "id": "bridge_call_prechecked",
      "description": "Bridge call was allowed by main-leader pretool guard",
      "type": "lifecycle"
    },
    {
      "id": "bridge_call_started",
      "description": "Bridge SDK call started",
      "type": "lifecycle"
    },
    {
      "id": "bridge_window_opened",
      "description": "Bridge leader opened the bridge window",
      "type": "lifecycle"
    },
    {
      "id": "bridge_packet_accepted",
      "description": "Bridge leader accepted the packet boundary",
      "type": "lifecycle"
    },
    {
      "id": "bridge_packet_rejected",
      "description": "Bridge leader rejected the packet boundary",
      "type": "terminal"
    },
    {
      "id": "team_create_started",
      "description": "Bridge team creation started",
      "type": "lifecycle"
    },
    {
      "id": "team_create_completed",
      "description": "Bridge team creation completed",
      "type": "lifecycle"
    },
    {
      "id": "team_create_failed",
      "description": "Bridge team creation failed",
      "type": "failure"
    },
    {
      "id": "task_create_started",
      "description": "Bridge task creation started",
      "type": "lifecycle"
    },
    {
      "id": "task_create_completed",
      "description": "Bridge task creation completed",
      "type": "lifecycle"
    },
    {
      "id": "task_create_failed",
      "description": "Bridge task creation failed",
      "type": "failure"
    },
    {
      "id": "task_created_recorded",
      "description": "TaskCreated hook accepted and recorded the task binding",
      "type": "lifecycle"
    },
    {
      "id": "message_dispatch_started",
      "description": "Teammate message dispatch started",
      "type": "lifecycle"
    },
    {
      "id": "message_dispatch_completed",
      "description": "Teammate message dispatch completed",
      "type": "lifecycle"
    },
    {
      "id": "message_dispatch_failed",
      "description": "Teammate message dispatch failed",
      "type": "failure"
    },
    {
      "id": "team_waiting",
      "description": "Bridge team is waiting or process polling",
      "type": "lifecycle"
    },
    {
      "id": "team_wait_timeout",
      "description": "Bridge team wait timed out or process was lost",
      "type": "failure"
    },
    {
      "id": "blocked_for_user_clarification",
      "description": "Bridge task blocked for user clarification",
      "type": "pause"
    },
    {
      "id": "paused_for_user_answer",
      "description": "Bridge result returned a user clarification request",
      "type": "pause",
      "terminal": true
    },
    {
      "id": "user_answer_received",
      "description": "Main leader recorded the user answer",
      "type": "pause",
      "terminal": true
    },
    {
      "id": "resume_same_l3_task",
      "description": "Runtime marked the same L3 task for resume",
      "type": "pause",
      "terminal": true
    },
    {
      "id": "continuation_of_previous_l3",
      "description": "Next L3 bridge call continues the previous user-answer context",
      "type": "pause",
      "terminal": true
    },
    {
      "id": "task_completion_started",
      "description": "Completion artifacts and reports are being validated",
      "type": "lifecycle"
    },
    {
      "id": "task_completion_rejected",
      "description": "Completion contract was rejected",
      "type": "failure"
    },
    {
      "id": "task_completion_completed",
      "description": "Completion contract was satisfied",
      "type": "lifecycle"
    },
    {
      "id": "task_failed",
      "description": "Bridge task failed",
      "type": "failure"
    },
    {
      "id": "team_delete_started",
      "description": "Bridge team deletion started",
      "type": "lifecycle"
    },
    {
      "id": "team_delete_completed",
      "description": "Bridge team deletion completed",
      "type": "lifecycle"
    },
    {
      "id": "team_delete_failed",
      "description": "Bridge team deletion failed",
      "type": "failure"
    },
    {
      "id": "bridge_call_denied",
      "description": "Bridge call denied by runtime guard",
      "type": "terminal",
      "terminal": true
    },
    {
      "id": "bridge_call_failed",
      "description": "Bridge SDK call failed",
      "type": "terminal",
      "terminal": true
    },
    {
      "id": "bridge_window_returned",
      "description": "Bridge result returned successfully",
      "type": "terminal",
      "terminal": true
    },
    {
      "id": "bridge_window_failed",
      "description": "Bridge window returned failure",
      "type": "terminal",
      "terminal": true
    },
    {
      "id": "bridge_window_partial_returned",
      "description": "Bridge window returned partial evidence",
      "type": "terminal",
      "terminal": true
    },
    {
      "id": "bridge_window_orphaned",
      "description": "Bridge window was marked orphaned",
      "type": "terminal",
      "terminal": true
    },
    {
      "id": "bridge_window_interrupted",
      "description": "Bridge window was interrupted",
      "type": "terminal",
      "terminal": true
    },
    {
      "id": "retry_attempt_scheduled",
      "description": "Runtime scheduled a bounded retry or repair action",
      "type": "recovery"
    },
    {
      "id": "enter_anomaly",
      "description": "Runtime routed the run to anomaly analysis",
      "type": "recovery"
    },
    {
      "id": "terminal_failure",
      "description": "Terminal failed bridge/window state",
      "type": "terminal",
      "terminal": true
    }
  ],
  "edges": [
    {
      "id": "runtime_truth_to_freeze",
