        "route_rerouted"
      ]
    },
    {
      "id": "phase_routes_policy",
      "from": "validate_route",
      "to": "build_bridge_packet",
      "phase_routes": [
        [
          "leader_freeze",
          "l2_advisory"
        ],
        [
          "leader_freeze",
          "l3_bridge"
        ],
        [
          "l2_advisory",
          "l3_bridge"
        ],
        [
          "l3_bridge",
          "l3_bridge"
        ],
        [
          "l3_bridge",
          "leader_freeze"
        ],
        [
          "l3_bridge",
          "l2_advisory"
        ],
        [
          "l3_bridge",
          "l4_implement"
        ],
        [
          "l3_bridge",
          "l4_execute"
        ],
        [
          "l3_bridge",
          "l4_anomaly"
        ],
        [
          "l4_implement",
          "l4_execute"
        ],
        [
          "l4_implement",
          "l4_anomaly"
        ],
        [
          "l4_execute",
          "l4_anomaly"
        ],
        [
          "l4_execute",
          "l4_implement"
        ],
        [
          "l4_anomaly",
          "l3_bridge"
        ],
        [
          "l4_anomaly",
          "l4_implement"
        ],
        [
          "l4_anomaly",
          "l4_execute"
        ]
      ]
    },
    {
