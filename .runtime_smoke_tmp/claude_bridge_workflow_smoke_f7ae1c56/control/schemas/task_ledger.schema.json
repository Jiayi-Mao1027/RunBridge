{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "control/schemas/task_ledger.schema.json",
  "title": "Task Ledger",
  "description": "Authoritative task-level state. Task is the only handoff unit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "run_id",
    "task_group",
    "task_kind",
    "objective",
    "status",
    "phase_gate",
    "depends_on",
    "blocked_by_task_ids",
    "inputs",
    "acceptance_contract",
    "required_artifacts",
    "produced_artifacts",
    "completion_checks",
    "completion_effect",
    "retry_count",
    "attempts",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.3.0"
    },
    "task_id": {
      "type": "string",
      "pattern": "^task_[A-Za-z0-9._-]+$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_[A-Za-z0-9._-]+$"
    },
    "task_group": {
      "type": "string",
      "enum": [
        "leader_freeze",
        "l2_advisory",
        "l3_bridge",
        "l4_implement",
        "l4_execute",
        "l4_anomaly"
      ]
    },
    "task_kind": {
      "type": "string",
      "enum": [
        "freeze_contract",
        "advisory_pass",
        "bridge_refresh",
        "bridge_curation",
        "bridge_preflight_gate",
        "implement_change",
        "implement_run_gate",
        "execute_run",
        "execute_postrun_check",
        "anomaly_analysis",
        "custom"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "created",
        "ready",
        "in_progress",
        "waiting_on_dependency",
        "waiting_on_approval",
        "blocked",
        "retryable_failure",
        "completed",
        "failed",
        "aborted",
        "noop"
      ]
    },
    "phase_gate": {
      "type": "boolean",
      "description": "Whether this task participates in deciding group exit / phase completion."
    },
    "spawned_by_task_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^task_[A-Za-z0-9._-]+$"
    },
    "handoff_to_group": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "leader_freeze",
        "l2_advisory",
        "l3_bridge",
        "l4_implement",
        "l4_execute",
        "l4_anomaly",
        null
      ]
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^task_[A-Za-z0-9._-]+$"
      },
      "uniqueItems": true
    },
    "dependents": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^task_[A-Za-z0-9._-]+$"
      },
      "uniqueItems": true
    },
    "blocked_by_task_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^task_[A-Za-z0-9._-]+$"
      },
      "uniqueItems": true
    },
    "approval_ref": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^apr_[A-Za-z0-9._-]+$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_root": {
          "type": "string"
        },
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/inputRef"
      }
    },
    "acceptance_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_outputs",
        "validation_requirements",
        "phase_exit_relevant"
      ],
      "properties": {
        "required_outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validation_requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "phase_exit_relevant": {
          "type": "boolean"
        }
      }
    },
    "required_artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifactRequirement"
      }
    },
    "produced_artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifactRef"
      }
    },
    "blocking_reason": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "dependency_unfinished",
            "approval_required",
            "missing_input",
            "missing_artifact",
            "validation_failed",
            "policy_denied",
            "runtime_error",
            "hard_stop",
            "illegal_transition",
            "other"
          ]
        },
        "details": {
          "type": "string"
        }
      }
    },
    "completion_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_outputs_present",
        "required_artifacts_present",
        "validation_passed"
      ],
      "properties": {
        "required_outputs_present": {
          "type": "boolean"
        },
        "required_artifacts_present": {
          "type": "boolean"
        },
        "validation_passed": {
          "type": "boolean"
        },
        "missing_outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "failed_validations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "completion_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_advance_phase",
        "may_spawn_next_tasks",
        "next_default_group"
      ],
      "properties": {
        "may_advance_phase": {
          "type": "boolean"
        },
        "may_spawn_next_tasks": {
          "type": "boolean"
        },
        "next_default_group": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "leader_freeze",
            "l2_advisory",
            "l3_bridge",
            "l4_implement",
            "l4_execute",
            "l4_anomaly",
            null
          ]
        },
        "next_task_candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/taskCandidate"
          }
        }
      }
    },
    "approval_category": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "intra_group_default",
        "cross_group_advance_default",
        "cross_group_reroute_default",
        "scope_change_requires_approval",
        "external_side_effect_requires_approval",
        "hard_stop",
        null
      ]
    },
    "retry_count": {
      "type": "integer",
      "minimum": 0
    },
    "attempts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/taskAttempt"
      }
    },
    "owner": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional executor reference. Non-authoritative."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "closed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "$defs": {
    "inputRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "task_ref",
            "artifact_ref",
            "path",
            "inline_text",
            "config",
            "parameter",
            "other"
          ]
        },
        "value": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "artifactRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "kind"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^art_[A-Za-z0-9._-]+$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "log",
            "report",
            "patch",
            "config",
            "result",
            "checkpoint",
            "evidence",
            "other"
          ]
        },
        "path_hint": {
          "type": [
            "string",
            "null"
          ]
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "path",
        "kind"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^art_[A-Za-z0-9._-]+$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "log",
            "report",
            "patch",
            "config",
            "result",
            "checkpoint",
            "evidence",
            "other"
          ]
        },
        "authoritative": {
          "type": "boolean"
        }
      }
    },
    "taskCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_group",
        "task_kind",
        "reason"
      ],
      "properties": {
        "task_group": {
          "type": "string",
          "enum": [
            "leader_freeze",
            "l2_advisory",
            "l3_bridge",
            "l4_implement",
            "l4_execute",
            "l4_anomaly"
          ]
        },
        "task_kind": {
          "type": "string",
          "enum": [
            "freeze_contract",
            "advisory_pass",
            "bridge_refresh",
            "bridge_curation",
            "bridge_preflight_gate",
            "implement_change",
            "implement_run_gate",
            "execute_run",
            "execute_postrun_check",
            "anomaly_analysis",
            "custom"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "taskAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "status",
        "started_at"
      ],
      "properties": {
        "attempt_id": {
          "type": "string",
          "pattern": "^att_[A-Za-z0-9._-]+$"
        },
        "status": {
          "type": "string",
          "enum": [
            "started",
            "completed",
            "failed",
            "aborted"
          ]
        },
        "worker_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}