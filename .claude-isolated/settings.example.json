{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "leader-orchestrator",
  "env": {
    "ANTHROPIC_BASE_URL": "__REPLACE_BASE_URL__",
    "ANTHROPIC_AUTH_TOKEN": "__REPLACE_AUTH_TOKEN__",
    "API_TIMEOUT_MS": "600000",
    "HTTP_PROXY": "",
    "HTTPS_PROXY": ""
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/data03/liang/mjy/.claude-isolated/hooks/session_start_summary.py\""
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/data03/liang/mjy/.claude-isolated/hooks/task_created.py\""
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/data03/liang/mjy/.claude-isolated/hooks/teammate_idle.py\""
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/data03/liang/mjy/.claude-isolated/hooks/task_completed.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/data03/liang/mjy/.claude-isolated/hooks/pre_bash_guard.py\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/data03/liang/mjy/.claude-isolated/hooks/pre_edit_guard.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/data03/liang/mjy/.claude-isolated/hooks/post_bash_check.py\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/data03/liang/mjy/.claude-isolated/hooks/post_edit_check.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "agent",
            "prompt": "Audit whether the current response reached a valid stage boundary. Check whether every task started in this turn has either a valid completion receipt or an explicit carry-forward status, and whether any required artifacts for the current stage are missing. Return JSON only. If valid, return {\"ok\": true}. If invalid, return {\"ok\": false, \"reason\": \"state exactly what is missing and which task or stage caused it\"}. $ARGUMENTS",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/data03/liang/mjy/.claude-isolated/hooks/session_end_checkpoint.py\""
          }
        ]
      }
    ]
  },
  "model": "gpt-5.4"
}
